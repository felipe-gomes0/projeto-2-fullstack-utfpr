# Porta da API. Se mudar, ajuste também VITE_API_URL no frontend/.env.
PORT=3001

# Conexão PostgreSQL.
# Sem Docker: aponte para o seu PostgreSQL.
# Com Docker: DB_PORT é a porta em que o banco do compose fica exposto na sua máquina.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=financas
DB_POOL_MAX=10

# JWT (gere um segredo longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h

# Origem permitida no CORS (endereço do front-end). A porta deve ser a mesma de FRONTEND_PORT no frontend/.env.
CORS_ORIGIN=http://localhost:5173

# Custo do bcrypt
BCRYPT_ROUNDS=10
