{
  "name": "financas-backend",
  "version": "1.0.0",
  "description": "API REST de controle financeiro pessoal (Projeto 2 - Full Stack)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node database/executar-sql.js database/schema.sql",
    "db:seed": "node database/seed.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
